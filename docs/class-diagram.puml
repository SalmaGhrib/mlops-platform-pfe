' ==========================================
' REPOSITORIES
' ==========================================
package "repository" #E8F5E9 {

    class UserRepository <<Repository>> {
        + findByEmail(email) : Optional<User>
    }

    class RoleRepository <<Repository>> {
        + findByName(name) : Optional<Role>
    }

    class MlProjectRepository <<Repository>> {
        + findByOwner(user) : List<MlProject>
        + findAllProjectIds() : List<Long>
    }

    class MlExperimentRepository <<Repository>> {
        + findByProject(project) : List<MlExperiment>
        + findActionableCustomDockerExperiments() : List<MlExperiment>
        + findByIdWithFiles(id) : Optional<MlExperiment>
        + findByMlflowRunId(runId) : Optional<MlExperiment>
        + countByStatus(status) : long
        + countByRuntimeMode(mode) : long
        + findCurrentProductionExperimentForProject() : MlExperiment
    }

    class MlExperimentMetricRepository <<Repository>> {
        + findByExperimentId(id) : List<MlExperimentMetric>
        + upsertMetric(...) : int
        + updateGlobalScoreByExperimentId() : int
        + updateProductionStateByExperimentId() : int
    }

    class UploadedProjectFileRepository <<Repository>> {
        + findByProjectId(projectId) : List<UploadedProjectFile>
    }

    class RunPipelineStepRepository <<Repository>> {
        + findByExperimentIdOrderByOrderIndexAsc() : List<RunPipelineStep>
    }

    class ModelDeploymentRepository <<Repository>> {
        + findByProjectIdAndActiveTrue() : Optional<ModelDeployment>
        + findByApiKey(apiKey) : Optional<ModelDeployment>
        + findDistinctRegisteredModelNames() : List<String>
    }

    class ModelDeploymentShareRepository <<Repository>> {
        + findByDeploymentId(deploymentId) : List<ModelDeploymentShare>
        + existsByDeploymentIdAndSharedWithUserId() : boolean
    }

    class ModelApiKeyRepository <<Repository>> {
        + findByKeyPrefix(prefix) : Optional<ModelApiKey>
        + findByDeploymentIdOrderByCreatedAtDesc() : List<ModelApiKey>
    }

    class ModelApiUsageRepository <<Repository>> {
        + countByDeploymentIdAndRequestedAtAfter() : long
        + findByApiKeyIdAndRequestedAtAfter() : List<ModelApiUsage>
    }

    class PredictionLogRepository <<Repository>> {
        + countByProjectIdAndCreatedAtAfter() : Long
        + countByProjectIdAndSuccessFalseAndCreatedAtAfter() : Long
    }

    class MonitoringAlertRepository <<Repository>> {
        + existsByIdempotencyKey(key) : boolean
        + findByProjectIdOrderByCreatedAtDesc() : List<MonitoringAlert>
    }

    class NotificationRepository <<Repository>> {
        + findByUserOrderByCreatedAtDesc(user) : List<Notification>
        + countByUserAndReadFalseAndCreatedAtGreaterThanEqual() : long
        + markAsReadByNotificationIdAndUserId() : int
    }

    class PasswordResetTokenRepository <<Repository>> {
        + findByToken(token) : Optional<PasswordResetToken>
    }

    class RetrainingConfigRepository <<Repository>> {
        + findByProjectId(projectId) : Optional<RetrainingConfig>
        + findEnabledConfigs() : List<RetrainingConfig>
    }

    class GitHubRetrainingConfigRepository <<Repository>> {
        + findByProjectId(projectId) : Optional<GitHubRetrainingConfig>
        + findBySecretHash(hash) : Optional<GitHubRetrainingConfig>
    }
}

' ==========================================
' SERVICES (key business services)
' ==========================================
package "service" #F3E5F5 {

    class AuthService <<Service>> {
        - userRepository : UserRepository
        - roleRepository : RoleRepository
        - jwtService : JwtService
        - passwordEncoder : PasswordEncoder
        + register(request) : ResponseEntity
        + login(request) : ResponseEntity
        + getMe(authHeader) : ResponseEntity
    }

    class UserService <<Service>> {
        - userRepository : UserRepository
        + updateProfile(user, request) : User
        + changePassword(user, request) : void
    }

    class MlProjectService <<Service>> {
        - mlProjectRepository : MlProjectRepository
        + createProject(user, request) : MlProject
        + getMyProjects(user) : List<MlProject>
        + getProjectById(user, id) : MlProject
        + updateProject(id, request) : MlProject
        + deleteProject(id) : void
    }

    class MlExperimentService <<Service>> {
        - mlExperimentRepository : MlExperimentRepository
        - mlExperimentMetricRepository : MlExperimentMetricRepository
        + uploadAndLaunchExperiment() : MlExperiment
        + getExperimentsByProject(projectId) : List<MlExperiment>
        + getPipelineStatus(experimentId) : Map
        + syncProjectResults(projectId) : void
        + syncRegisteredModel(registeredModelName) : void
    }

    class ModelDeploymentService <<Service>> {
        - modelDeploymentRepository : ModelDeploymentRepository
        + deployProductionModel(request) : ModelDeployment
        + getActiveDeploymentByProject(projectId) : Optional<ModelDeployment>
        + syncKubernetesDeployments() : void
        + shareDeployment(deploymentId, userIds, permission) : void
        + stopDeployment(deploymentId) : void
    }

    class ModelRegistryService <<Service>> {
        + getMyRegisteredModels(user) : List
        + chooseBestVersion(modelName, priorities) : String
        + promoteBestVersion(modelName, priorities) : String
        + syncModelRegistryToDatabase(modelName) : void
    }

    class ModelGatewayService <<Service>> {
        + listApiKeys(modelId, user) : List<ModelApiKey>
        + createApiKey(modelId, user, request) : ModelApiKey
        + enableApiAccess(deploymentId) : String
        + disableApiAccess(deploymentId) : void
        + predictExternal(modelName, input, apiKey) : Map
    }

    class PredictionService <<Service>> {
        + getMyProductionModels(user) : List
        + predict(request, user) : Map
        + predictImage(modelName, imageFile, user) : Map
    }

    class MonitoringService <<Service>> {
        + getMonitoringSummary() : Map
    }

    class MonitoringAlertService <<Service>> {
        + createAlert(alert) : MonitoringAlert
        + evaluateProject(projectId) : void
    }

    class NotificationService <<Service>> {
        - notificationRepository : NotificationRepository
        + getMyNotifications(user) : List<Notification>
        + getUnreadCount(user) : long
        + markAsRead(notificationId, user) : void
        + markAllAsRead(user) : void
        + notifyAdmins(title, message, type) : void
    }

    class RetrainingConfigService <<Service>> {
        - retrainingConfigRepository : RetrainingConfigRepository
        + saveConfig(projectId, request) : RetrainingConfig
        + getConfig(projectId) : Optional<RetrainingConfig>
        + disableRetraining(projectId) : void
    }

    class AutoRetrainingService <<Service>> {
        + evaluateAndTrigger() : void
        + forceRetrainingNow(projectId) : void
        + getProjectStatus(projectId) : Map
    }

    class RetrainingDryRunService <<Service>> {
        + dryRun() : Map
    }

    class RetrainingDecisionService <<Service>> {
        + evaluate(config) : RetrainingDecision
    }

    class GitHubRetrainingService <<Service>> {
        + handleGitHubPush(payload) : void
        + getGitHubConfig(projectId) : GitHubRetrainingConfig
        + generateKey(projectId) : String
        + revokeKey(projectId) : void
    }

    class KubernetesBuildService <<Service>> {
        - workspaceService : CustomDockerWorkspaceService
        + launchImageBuildJob(project, experiment) : BuildJobResult
        + getBuildJobStatus(jobName) : String
        + getBuildJobLogs(jobName) : String
    }

    class KubernetesJobService <<Service>> {
        + launchTrainingJob(experiment) : String
        + getJobStatus(jobName) : String
        + getJobLogs(jobName) : String
    }

    class CustomDockerRunWatcher <<Service>> {
        - kubernetesBuildService : KubernetesBuildService
        + watchPendingExperiments() : void
        + processExperiment(experiment) : void
        + launchBuildJob(experiment) : void
        + syncBuildJob(experiment) : void
    }

    class CustomDockerWorkspaceService <<Service>> {
        - uploadsStorageProperties : UploadsStorageProperties
        - datasetFileResolverService : DatasetFileResolverService
        + prepareWorkspace(project, experiment) : CustomDockerWorkspace
        + validateWorkspace(workspace) : void
        + validateDockerfileSources(workspace, dockerfileContent) : void
    }

    class DatasetFileResolverService <<Service>> {
        + resolveDatasetFile(project, experiment) : UploadedProjectFile
    }

    class MlflowTrackingClientService <<Service>> {
        + getRun(runId) : Run
        + searchRuns(experimentId) : List<Run>
        + logMetric(runId, key, value) : void
        + logModel(runId, modelPath) : void
    }

    class ModelConsistencyService <<Service>> {
        + audit(modelName) : Map
        + reconcile(modelName) : Map
        + reconcileAll() : Map
    }

    class DashboardService <<Service>> {
        + getSummary(user) : Map
    }

    class AdminMonitoringOverviewService <<Service>> {
        + getOverview() : Map
    }

    class AdminUserService <<Service>> {
        + getAllUsers() : List<User>
        + updateUserRole(id, role) : User
        + deleteUser(id) : void
    }

    class UserMonitoringService <<Service>> {
        + getDashboard(user, projectId) : Map
    }

    class RunPipelineStepService <<Service>> {
        + markSucceeded(experiment, stepCode, message) : void
        + markFailed(experiment, stepCode, ...) : void
        + appendLogs(experiment, stepCode, logs) : void
    }

    class CustomDockerPersistenceService <<Service>> {
        + markBuildCompleted(experimentId, logs) : MlExperiment
        + updateExperiment(experimentId, updater) : void
    }

    class ModelQualityService <<Service>> {
        + computeGlobalScore(experiment) : Double
    }

    class ReconcileDeploymentsKubernetesService <<Service>> {
        + reconcileAll() : void
    }
}

