@startuml MLOps_Platform_Class_Diagram

skinparam packageStyle rectangle
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 60
skinparam ranksep 40
skinparam defaultFontSize 11
skinparam classFontSize 13
skinparam packageFontSize 14
skinparam packageBorderColor #555555
skinparam classBorderColor #333333
skinparam classBackgroundColor #FEFECE
skinparam noteBackgroundColor #FFFFCC
skinparam noteBorderColor #AAAAAA

title MLOps Platform — Diagramme de Classes Complet\n(Sprint Boot / JPA / AKS / MLflow / Kubeflow)

' ==========================================
' ENUMS
' ==========================================
package "entity::enums" #FFE0B2 {

    enum RoleType <<Enum>> {
        ADMIN
        USER
    }

    enum AccountStatus <<Enum>> {
        ACTIVE
        INACTIVE
        LOCKED
    }

    enum ProjectStatus <<Enum>> {
        CREATED
        RUNNING
        COMPLETED
        FAILED
    }

    enum ExperimentStatus <<Enum>> {
        CREATED
        RUNNING
        COMPLETED
        FAILED
        TERMINAL
    }

    enum UploadedFileType <<Enum>> {
        TRAINING_SCRIPT
        DATASET_FILE
        DATASET_ARCHIVE
        DOCKERFILE
        REQUIREMENTS
        AUXILIARY
        MODEL_FILE
        OTHER
    }

    enum DeploymentStatus <<Enum>> {
        PENDING
        DEPLOYING
        DEPLOYED
        FAILED
        STOPPED
    }

    enum DeploymentVisibility <<Enum>> {
        PRIVATE
        SHARED
        PUBLIC
    }

    enum AlertType <<Enum>> {
        MODEL_QUALITY_FAILED
        DATA_DRIFT
        PREDICTION_ERROR_RATE
        PERFORMANCE_DROP
        GLOBAL_SCORE_TOO_LOW
        FAILED_RUNS
    }

    enum AlertSeverity <<Enum>> {
        INFO
        WARNING
        CRITICAL
    }

    enum NotificationType <<Enum>> {
        RUN_COMPLETED
        RUN_FAILED
        DEPLOYMENT_DEPLOYED
        DEPLOYMENT_FAILED
        RETRAINING_TRIGGERED
        RETRAINING_COMPLETED
        NEW_PRODUCTION_VERSION
        MONITORING_ALERT
        SYSTEM_INFO
    }

    enum NotificationTargetType <<Enum>> {
        EXPERIMENT
        DEPLOYMENT
        PROJECT
        MONITORING
        SYSTEM
    }

    enum RetrainingFrequencyType <<Enum>> {
        DAY
        WEEK
        MONTH
    }

    enum RetrainingStrategy <<Enum>> {
        SCHEDULED_ONLY
        SCHEDULED_WITH_MONITORING
        SMART_MONITORING_ONLY
        FULL_SMART
    }

    enum RetrainingState <<Enum>> {
        IDLE
        EVALUATING
        TRIGGERED
        RUNNING
        COMPLETED
        FAILED
        COOLDOWN
    }

    enum RetrainingTriggerType <<Enum>> {
        SCHEDULED
        MANUAL
        GITHUB_PUSH
        FAILED_RUNS
        PREDICTION_ERRORS
        DATA_DRIFT
        PERFORMANCE_DROP
        SMART_MONITORING
        SKIPPED_NO_SIGNAL
        BLOCKED_BY_SECURITY
    }

    enum RetrainingSeverity <<Enum>> {
        NONE
        LOW
        MEDIUM
        HIGH
        CRITICAL
    }

    enum RetrainingSecurityLevel <<Enum>> {
        NONE
        SECURITY_ALERT_ONLY
        BLOCK_MODEL
        RETRAIN_RECOMMENDED
        RETRAIN_REQUIRED
    }

    enum RetrainingDataPolicy <<Enum>> {
        ORIGINAL_DATASET
        LATEST_DATASET
        MERGED_DATASET
    }
}

