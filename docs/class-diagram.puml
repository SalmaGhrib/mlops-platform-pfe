' ==========================================
' RELATIONSHIPS - ENTITIES
' ==========================================

User }o--|| Role : "1 role"
User }o--o{ PasswordResetToken : "0..*"
User }o--o{ Notification : "0..*"

MlProject }o--|| User : "1 owner"
MlProject }o--o{ MlExperiment : "0..*"
MlProject }o--o{ UploadedProjectFile : "0..*"

MlExperiment }o--|| MlProject : "1 project"
MlExperiment }o--o{ MlExperimentMetric : "0..*"
MlExperiment }o--o| UploadedProjectFile : "0..1 datasetFile"
MlExperiment }o--o| UploadedProjectFile : "0..1 modelFile"

ModelDeployment }o--o{ ModelDeploymentShare : "0..*"
ModelDeployment }o--o{ ModelApiKey : "0..*"
ModelApiKey }o--o{ ModelApiUsage : "0..*"

