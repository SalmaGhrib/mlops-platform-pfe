AuthController ..> AuthService : <<uses>>
AuthController ..> JwtService : <<uses>>
UserController ..> UserService : <<uses>>
AdminUserController ..> AdminUserService : <<uses>>
MlProjectController ..> MlProjectService : <<uses>>
MlExperimentController ..> MlExperimentService : <<uses>>
ModelDeploymentController ..> ModelDeploymentService : <<uses>>
